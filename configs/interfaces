auto lo
iface lo inet loopback

iface ens33 inet manual
iface ens34 inet manual

auto vmbr0
iface vmbr0 inet static
        address 192.168.23.128/24
        gateway 192.168.23.2
        bridge-ports ens33
        bridge-stp off
        bridge-fd 0

auto vmbr1
iface vmbr1 inet manual
        bridge-ports ens34
        bridge-stp off
        bridge-fd 0